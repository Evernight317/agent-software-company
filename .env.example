# LLM API Configuration (用户自行填写)
# 支持 OpenAI 及兼容 API (如 Azure, 本地模型等)

# API Key
LLM_API_KEY=sk-your-api-key-here

# Base URL (OpenAI 默认: https://api.openai.com/v1)
# 兼容 API 可改为对应地址
LLM_BASE_URL=https://api.openai.com/v1

# 模型配置
LLM_MODEL_PRIMARY=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# 请求参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
